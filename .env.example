# =====================================================================
# TwinEngines 实盘 .env 模板 (仅示例, 真实部署请改为 .env 并保密)
# 安全警告:
#   * 不要提交 .env 到 git
#   * 默认 DRY_RUN=true + ENABLE_REAL_ORDERS=false (双保险)
#   * 真实下单必须同时把这两个开关切换
# =====================================================================

# -- 钱包 / 链上认证 ---------------------------------------------------
# Polymarket 设置页显示的"代理钱包"地址 (Funder), 用于 ProxyType 1/2
POLYMARKET_PROXY_ADDRESS=0xYOUR_PROXY_ADDRESS

# 与 Funder 一一对应的 EOA 私钥 (0x + 64 hex)
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# 签名类型: 0=EOA, 1=Magic Proxy (默认), 2=Gnosis Safe
SIGNATURE_TYPE=1

# Polygon RPC (建议公共节点, 失败可换 https://polygon-rpc.com)
POLYGON_RPC_URL=https://polygon-bor.publicnode.com

# -- (可选) Polymarket Builder API Key --------------------------------
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# -- 安全开关 --------------------------------------------------------
# 本地开发: 建议保持影子。VPS 充值实盘可改为:
#   DRY_RUN=false
#   ENABLE_REAL_ORDERS=true
# 资金不足时自动记影子单 (不下链上), 勿关:
AUTO_SHADOW_ON_INSUFFICIENT_FUNDS=true
DRY_RUN=true
ENABLE_REAL_ORDERS=false

# -- 网络/超时 -------------------------------------------------------
HTTP_TIMEOUT_SEC=8
WS_PING_INTERVAL_SEC=30
WS_PING_TIMEOUT_SEC=10
WS_MAX_RETRIES=5
WS_RETRY_DELAY_SEC=5

# -- 订单轮询 -------------------------------------------------------
ORDER_POLL_INTERVAL_SEC=1.0
ORDER_POLL_MAX_WAIT_SEC=30
FOK_FALLBACK_TO_GTC=true

# -- 行情可信度 -----------------------------------------------------
BOOK_MAX_STALENESS_SEC=5

# -- 资金安全兜底 (与策略无关, 实盘 io 兜底) -----------------------
DAILY_MAX_LOSS_USDC=50
# naked 小资金实测专用：相对日内回撤停手；0=关闭，0.05=从日内权益高点回撤 5% 停手
NAKED_DAILY_DRAWDOWN_STOP=0.05
ABORT_ON_UNKNOWN_API_ERROR=true
# 单窗口风险上限：绝对 cap <=0 表示关闭绝对金额限制，只使用资金比例 cap
REAL_MAX_WINDOW_RISK_USDC=0
REAL_MAX_WINDOW_RISK_RATIO=0.15

# -- 日志/监控 ------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=INFO
HEALTH_CHECK_PORT=18080

# -- 实盘 IO 集成 (新增) ---------------------------------------------
# 1) HTTP User-Agent (Polymarket CLOB 部分端点要求 UA, 否则 403)
HTTP_USER_AGENT=TwinEngines/1.0 (+contact:ops)

# 2) Polymarket 5min BTC 合约动态发现
MARKET_UNDERLYING=BTC
MARKET_HORIZON_MINUTES=5
MARKET_REFRESH_INTERVAL_SEC=60

# 3) USDC allowance 启动校验 (allowance < min_order_quote * N 时拒绝启动)
MIN_USDC_ALLOWANCE_MULTIPLE=100

# 4) 实盘对账与权益刷新
EQUITY_REFRESH_INTERVAL_SEC=30
RECONCILE_INTERVAL_SEC=30

# 5) 状态持久化 / 单实例锁
STATE_DB_PATH=data_runtime/state.sqlite
INSTANCE_LOCK_PATH=data_runtime/twinengines.pid

# 6) (可选) Telegram 告警
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 7) 空跑信号附带盘口诊断 (--dry-run-signals)
# 用于估算「当时盘口是否可能成交」的检查名义金额 (USDC), 不影响真实下单
SHADOW_BOOK_CHECK_STAKE_USDC=5.0

# 8) 自动赎回 (默认开启，建议保持 true)
# 目的: 已结算 winning token 自动兑换回 USDC，避免资金长期锁定在头寸里
AUTO_REDEEM_ENABLED=true
AUTO_REDEEM_INTERVAL_SEC=30
AUTO_REDEEM_RECEIPT_WAIT_SEC=20

# 9) 代理钱包/Relayer 赎回所需 Builder 凭据 (signature_type=1/2 时必填)
# 若未加入 Builder 计划，请先申请官方 Builder access
# https://docs.polymarket.com/developers/builders/builder-intro
POLY_BUILDER_API_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=
